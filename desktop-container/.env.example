# Choose unique values per node installed on this host. Do not reuse another
# node's project name: it also identifies its persistent volumes and network.
BOARD_PROJECT_NAME=agent-board
BOARD_CONTAINER_NAME=agent-board-desktop
BOARD_IMAGE=agent-board:local
BOARD_VIEWER_PORT=6080

# Optional remote compute access. Keep .env private and out of version control.
# Empty token disables the Kaggle experiment adapter; no old login is imported.
KAGGLE_API_TOKEN=
# Consent switch only, not a Molab token. Agent creates sessions via browser.
# If account login is required, the owner signs in inside the container viewer.
MOLAB_ENABLED=false
